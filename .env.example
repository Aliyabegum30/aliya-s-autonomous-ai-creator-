# PostgreSQL connection string.
# Recommended: a free hosted Postgres instance (Neon or Supabase).
# Include sslmode=require for hosted providers.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Shared secret required in the Authorization header when calling
# POST /internal/run-cycle. This route is called ONLY by the GitHub Actions
# scheduler (Step 2+ / Step 8) — it is never exposed to the evaluator.
RUN_CYCLE_SECRET=change-this-to-a-long-random-string

# Runtime LLM keys — not used yet (added in a later step).
GEMINI_API_KEY=
GROQ_API_KEY=

# Local server port — not used yet (added in a later step).
PORT=3000
