# PostgreSQL connection string.
# Recommended: a free hosted Postgres instance (Neon or Supabase).
# Include sslmode=require for hosted providers.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Shared secret required in the Authorization header when calling
# POST /internal/run-cycle. This route is called ONLY by the GitHub Actions
# scheduler — it is never exposed to the evaluator, and is not part of the
# mandatory POST /api/agent/init / GET /api/agent/feed contract.
RUN_CYCLE_SECRET=change-this-to-a-long-random-string

# Primary LLM (structured JSON output for editorial scoring + generation).
# Free tier available via https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback LLM. Only used if Gemini fails and this is set.
# Free tier available via https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model names without a code change if a
# provider renames/retires a model. Verify current model ids in each
# provider's docs before deploying.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Local server port.
PORT=3000
